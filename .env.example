# Anthropic API key — used by the in-app chat
VITE_ANTHROPIC_API_KEY=

# Data source: "local" (fetch /data/*.json files; default) or "supabase"
VITE_DATA_SOURCE=local

# Supabase config — required only when VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Refresh API — required for the Settings → Refresh Data button.
# Leave empty in dev; the button will surface a "service not configured" toast.
# When set, the frontend POSTs to ${VITE_REFRESH_API_URL}/api/refresh and
# subscribes to ${VITE_REFRESH_API_URL}/api/refresh/{jobId}/stream for SSE progress.
VITE_REFRESH_API_URL=
VITE_REFRESH_API_PASSWORD=
